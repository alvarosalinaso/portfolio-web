    "iframe_code": "<div id=\"observable-worldcup-bracket\" style=\"width:100%;min-height:400px;background:#0d1117;border-radius:8px;padding:1rem;\">\n  <p style=\"color:#8b949e;text-align:center;\">Cargando visualización...</p>\n</div>\n<script type=\"module\">\nimport * as Plot from \"https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6/+esm\";\nimport * as d3 from \"https://cdn.jsdelivr.net/npm/d3@7/+esm\";\n\nconst resp = await fetch(\"https://alvarosalinaso.github.io/portfolio-web/data/observable_bracket.csv\");\nconst data = await resp.json();\n\nconst container = document.getElementById(\"observable-worldcup-bracket\");\ncontainer.innerHTML = \"\";\n\nconst chart = Plot.plot({\n  style: { background: \"#0d1117\", color: \"#e6edf3\", fontFamily: \"Inter, sans-serif\" },\n  width: Math.min(container.clientWidth, 960),\n  height: 450,\n  x: { grid: true, label: \"X\" },\n  y: { grid: true, label: \"Y\" },\n  marks: [\n    Plot.barY(Array.isArray(data) ? data : data.games || data.seasons || [], {\n      x: \"x\",\n      y: \"y\",\n      fill: \"#58a6ff\"\n    }),\n    Plot.ruleY([0])\n  ]\n});\n\ncontainer.appendChild(chart);\n</script>\n<noscript>\n  <p><a href=\"https://observablehq.com/@alvarosalinaso/worldcup-bracket\" target=\"_blank\">Ver notebook en Observable</a></p>\n</noscript>",
